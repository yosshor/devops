# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "kalilinux/rolling"
  config.vm.box_check_update = false
  config.vm.hostname = "kali-lab"

  # Keep the VM on a private host-only network so it is reachable from the host
  # without exposing it to the broader network.
  config.vm.network "private_network", ip: "192.168.56.20"

  # Optional: expose a local service from the guest to the host.
  # config.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"

  # Disable the default shared folder unless you explicitly want it.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |vb|
    vb.name = "kali-lab"
    vb.gui = false
    vb.memory = "4096"
    vb.cpus = 2
    vb.customize ["modifyvm", :id, "--audio", "none"]
    vb.customize ["modifyvm", :id, "--clipboard", "bidirectional"]
  end

  config.vm.provision "shell", privileged: true, inline: <<-SHELL
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
      curl wget ca-certificates git net-tools dnsutils jq unzip zip gnupg \
      build-essential python3 python3-pip python3-venv software-properties-common

    echo "Kali lab VM ready."
    echo "Access via: ssh vagrant@192.168.56.20"
  SHELL
end
